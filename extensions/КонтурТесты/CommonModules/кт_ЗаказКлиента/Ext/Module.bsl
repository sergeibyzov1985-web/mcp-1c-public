// Перепроведение уже проведённого заказа клиента.
// Сравнение движений не смотрит на порядок строк. Запись всегда откатывается.

Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты
		.ДобавитьТестовыйНабор("Заказ клиента")
		.ДобавитьСерверныйТест("ПерепроведениеНеМеняетДвижения");
	
КонецПроцедуры

Процедура ПерепроведениеНеМеняетДвижения() Экспорт
	
	Ссылка = ПоследнийПроведенныйЗаказ();
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Ссылка)).ЭтоИстина();
	До = СнимокДвижений(Ссылка);
	НачатьТранзакцию();
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		После = СнимокДвижений(Ссылка);
		Если Не СнимкиСовпадают(До, После) Тогда
			ВызватьИсключение "Движения заказа после перепроведения отличаются";
		КонецЕсли;
		ВызватьИсключение "ОткатПроверкиДвижений";
	Исключение
		ОтменитьТранзакцию();
		Если ОписаниеОшибки() <> "ОткатПроверкиДвижений" Тогда
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

Функция ПоследнийПроведенныйЗаказ()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента КАК Заказ
	|ГДЕ
	|	Заказ.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заказ.Дата УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	
КонецФункции

Функция СнимокДвижений(Ссылка)
	
	Объект = Ссылка.ПолучитьОбъект();
	Строки = Новый Массив;
	Для Каждого Набор Из Объект.Движения Цикл
		Набор.Прочитать();
		МетаРегистра = Набор.Метаданные();
		Записи = Новый СписокЗначений;
		Для Каждого Запись Из Набор Цикл
			Записи.Добавить(ПредставлениеЗаписи(Запись, МетаРегистра));
		КонецЦикла;
		Записи.СортироватьПоЗначению();
		Строки.Добавить(МетаРегистра.ПолноеИмя() + "=" + СтрСоединить(Записи.ВыгрузитьЗначения(), "|"));
	КонецЦикла;
	Список = Новый СписокЗначений;
	Для Каждого Строка Из Строки Цикл
		Список.Добавить(Строка);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), Символы.ПС);
	
КонецФункции

Функция ПредставлениеЗаписи(Запись, МетаРегистра)
	
	Части = Новый Массив;
	Если Метаданные.РегистрыНакопления.Содержит(МетаРегистра) Тогда
		Части.Добавить("Период:" + Формат(Запись.Период, "ДФ=yyyyMMddHHmmss"));
		Части.Добавить("Вид:" + Строка(Запись.ВидДвижения));
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(МетаРегистра)
		И МетаРегистра.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		Части.Добавить("Период:" + Формат(Запись.Период, "ДФ=yyyyMMddHHmmss"));
	КонецЕсли;
	ДобавитьПоля(Части, Запись, МетаРегистра.Измерения);
	ДобавитьПоля(Части, Запись, МетаРегистра.Ресурсы);
	ДобавитьПоля(Части, Запись, МетаРегистра.Реквизиты);
	Возврат СтрСоединить(Части, ";");
	
КонецФункции

Процедура ДобавитьПоля(Части, Запись, Поля)
	
	Для Каждого Поле Из Поля Цикл
		Части.Добавить(Поле.Имя + ":" + Строка(Запись[Поле.Имя]));
	КонецЦикла;
	
КонецПроцедуры

Функция СнимкиСовпадают(До, После)
	
	Возврат До = После;
	
КонецФункции
