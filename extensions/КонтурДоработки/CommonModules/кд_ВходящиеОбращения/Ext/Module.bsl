// Категория входящего обращения по тексту письма.
// Первое совпавшее правило побеждает. Новая категория — строка в ПравилаКатегорий(), не новая ветка Если.
// Если ни один маркер не найден, возвращается КатегорияПоУмолчанию().

Функция КатегорияПоТексту(ТекстПисьма) Экспорт
	
	НРегТекст = НРег(Строка(ТекстПисьма));
	Для Каждого Правило Из ПравилаКатегорий() Цикл
		Для Каждого Маркер Из Правило.Маркеры Цикл
			Если СтрНайти(НРегТекст, Маркер) > 0 Тогда
				Возврат Правило.Категория;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат КатегорияПоУмолчанию();
	
КонецФункции

Функция КатегорияПоУмолчанию() Экспорт
	
	Возврат "Прочее";
	
КонецФункции

Функция ПравилаКатегорий() Экспорт
	
	Правила = Новый Массив;
	Правила.Добавить(ПравилоКатегории("Заказ", "заказ,короб"));
	Возврат Правила;
	
КонецФункции

Функция ПравилоКатегории(Категория, МаркерыСтрокой)
	
	Маркеры = Новый Массив;
	Для Каждого Часть Из СтрРазделить(МаркерыСтрокой, ",", Ложь) Цикл
		Маркер = НРег(СокрЛП(Часть));
		Если ЗначениеЗаполнено(Маркер) Тогда
			Маркеры.Добавить(Маркер);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("Категория, Маркеры", Категория, Маркеры);
	
КонецФункции
