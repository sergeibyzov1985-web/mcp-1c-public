КонецФункции

Функция ОбеспечитьСоглашение(Партнер, Контрагент, Организация, Валюта, ВидЦен, Склад, Отчет)
	
	Имя = "КД Тестовое соглашение";
	Ссылка = Справочники.СоглашенияСКлиентами.НайтиПоНаименованию(Имя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Отчет.Добавить("Соглашение: уже было");
		Возврат Ссылка;
	КонецЕсли;
	
	Объект = Справочники.СоглашенияСКлиентами.СоздатьЭлемент();
	Объект.Наименование = Имя;
	Объект.Номер = "КД-1";
	Объект.Дата = ТекущаяДатаСеанса();
	Объект.Партнер = Партнер;
	Объект.Контрагент = Контрагент;
	Объект.Организация = Организация;
	Объект.Валюта = Валюта;
	Объект.ВалютаВзаиморасчетов = Валюта;
	Объект.ВидЦен = ВидЦен;
	Объект.Склад = Склад;
	Объект.Статус = Перечисления.СтатусыСоглашенийСКлиентами.Действует;
	Объект.Согласован = Истина;
	Объект.Типовое = Ложь;
	Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	Объект.ЦенаВключаетНДС = Истина;
	Объект.ДатаНачалаДействия = НачалоДня(ТекущаяДатаСеанса());
	Объект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам;
	Объект.ВариантРасчетаЦен = Перечисления.ВариантыРасчетаЦенПоСоглашениямСКлиентами.ВидЦенВШапке;
	Объект.ИспользуютсяДоговорыКонтрагентов = Ложь;
	ЗаписатьОбъект(Объект, "Соглашение", Истина);
	Отчет.Добавить("Соглашение: создано");
	Возврат Объект.Ссылка;
	
КонецФункции

Процедура ОбеспечитьЗаказ(Соглашение, Партнер, Контрагент, Организация, Склад, Валюта, Номенклатура, СтавкаНДС, Отчет)
	
	Существующий = НайтиЗаказ(Партнер);
	Если ЗначениеЗаполнено(Существующий) Тогда
		Отчет.Добавить("Заказ: уже был " + Существующий.Номер);
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = Документы.ЗаказКлиента.СоздатьДокумент();
	ДокументОбъект.Дата = ТекущаяДатаСеанса();
	Попытка
		ДокументОбъект.Заполнить(Соглашение);
	Исключение
		Отчет.Добавить("Заполнить по соглашению: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	ДокументОбъект.Партнер = Партнер;
	ДокументОбъект.Контрагент = Контрагент;
	ДокументОбъект.Организация = Организация;
	ДокументОбъект.Соглашение = Соглашение;
	ДокументОбъект.Склад = Склад;
	ДокументОбъект.Валюта = Валюта;
	ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
	ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаНеОблагаетсяНДС;
	ДокументОбъект.ЦенаВключаетНДС = Истина;
	ДокументОбъект.Комментарий = "кд тестовые данные";
	
	Строка = ДокументОбъект.Товары.Добавить();
	Строка.Номенклатура = Номенклатура;
	Строка.Количество = 1;
	Строка.КоличествоУпаковок = 1;
	Строка.Цена = 100;
	Строка.Сумма = 100;
	Строка.СтавкаНДС = СтавкаНДС;
	Строка.Склад = Склад;
	
	ЗаписатьОбъект(ДокументОбъект, "Заказ");
	Отчет.Добавить("Заказ: записан " + ДокументОбъект.Номер);
	
КонецПроцедуры

Функция НайтиЗаказ(Партнер)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказКлиента КАК Заказ
	|ГДЕ
	|	Заказ.Партнер = &Партнер
	|	И НЕ Заказ.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Документы.ЗаказКлиента.ПустаяСсылка();
	
КонецФункции

Процедура ЗаписатьОбъект(Объект, Заголовок, Загрузка = Ложь)
	
	Если Загрузка Тогда
		Объект.ОбменДанными.Загрузка = Истина;
	КонецЕсли;
	
	Попытка
		Объект.Записать();
	Исключение
		Текст = Заголовок + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Для Каждого Сообщение Из Сообщения Цикл
			Текст = Текст + Символы.ПС + Сообщение.Текст;
		КонецЦикла;
		ВызватьИсключение Текст;
	КонецПопытки;
	
КонецПроцедуры
