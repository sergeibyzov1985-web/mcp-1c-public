КонецФункции

Функция ОбеспечитьНоменклатуру(ВидНоменклатуры, Единица, СтавкаНДС, Отчет)
	
	Имя = "КД Тестовый товар";
	Ссылка = Справочники.Номенклатура.НайтиПоНаименованию(Имя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Отчет.Добавить("Номенклатура: уже была");
		Возврат Ссылка;
	КонецЕсли;
	
	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Наименование = Имя;
	Объект.НаименованиеПолное = Имя;
	Объект.ВидНоменклатуры = ВидНоменклатуры;
	Объект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Товар;
	Объект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать;
	Объект.ЕдиницаИзмерения = Единица;
	Объект.ЕдиницаДляОтчетов = Единица;
	Объект.КоэффициентЕдиницыДляОтчетов = 1;
	Объект.СтавкаНДС = СтавкаНДС;
	Объект.Качество = Перечисления.ГрадацииКачества.Новый;
	ЗаписатьОбъект(Объект, "Номенклатура", Истина);
	Отчет.Добавить("Номенклатура: создана");
	Возврат Объект.Ссылка;
	
КонецФункции

Функция ОбеспечитьПартнера(Отчет)
	
	Имя = "КД Тестовый клиент";
	Ссылка = Справочники.Партнеры.НайтиПоНаименованию(Имя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Если Не ЗначениеЗаполнено(Ссылка.ЮрФизЛицо) Тогда
			Объект = Ссылка.ПолучитьОбъект();
			Объект.Клиент = Истина;
			Объект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
			ЗаписатьОбъект(Объект, "Партнер");
			Отчет.Добавить("Партнер: дописано юрлицо");
		Иначе
			Отчет.Добавить("Партнер: уже был");
		КонецЕсли;
		Возврат Ссылка;
	КонецЕсли;
	
	Объект = Справочники.Партнеры.СоздатьЭлемент();
	Объект.Наименование = Имя;
	Объект.Клиент = Истина;
	Объект.ЮрФизЛицо = Перечисления.КомпанияЧастноеЛицо.Компания;
	Объект.ДатаРегистрации = ТекущаяДатаСеанса();
	Объект.Комментарий = "кд тестовые данные";
	ЗаписатьОбъект(Объект, "Партнер");
	Отчет.Добавить("Партнер: создан");
	Возврат Объект.Ссылка;
	
КонецФункции

