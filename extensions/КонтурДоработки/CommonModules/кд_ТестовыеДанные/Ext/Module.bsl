// Идемпотентно создаёт минимум справочников, без которого ЗаказКлиента не записывается,
// и пробует записать непроведённый заказ. Повторный вызов не плодит дубли.

Функция Создать() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Отчет = Новый Массив;
	Константы.ИспользоватьЗаказыКлиентов.Установить(Истина);
	Константы.ИспользоватьСоглашенияСКлиентами.Установить(Истина);
	Константы.ИспользоватьНесколькоСкладов.Установить(Истина);
	Отчет.Добавить("Включены заказы клиентов, соглашения и несколько складов");
	
	Организация = ОрганизацияПоУмолчанию();
	Валюта = Справочники.Валюты.НайтиПоНаименованию("RUB", Истина);
	Единица = Справочники.УпаковкиЕдиницыИзмерения.НайтиПоНаименованию("шт", Истина);
	СтавкаНДС = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС", Истина);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат "Ошибка: в базе нет организации";
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Валюта) Или Не ЗначениеЗаполнено(Единица) Или Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		Возврат "Ошибка: нет RUB, шт или ставки «Без НДС»";
	КонецЕсли;
	
	Отчет.Добавить("Организация: " + Организация);
	Отчет.Добавить("Валюта: " + Валюта);
	
	Склад = ОбеспечитьСклад(Отчет);
	ВидЦен = ОбеспечитьВидЦен(Валюта, Отчет);
	ВидНоменклатуры = ОбеспечитьВидНоменклатуры(Отчет);
	Номенклатура = ОбеспечитьНоменклатуру(ВидНоменклатуры, Единица, СтавкаНДС, Отчет);
	Партнер = ОбеспечитьПартнера(Отчет);
	Контрагент = ОбеспечитьКонтрагента(Партнер, Отчет);
	Соглашение = ОбеспечитьСоглашение(Партнер, Контрагент, Организация, Валюта, ВидЦен, Склад, Отчет);
	ОбеспечитьЗаказ(Соглашение, Партнер, Контрагент, Организация, Склад, Валюта, Номенклатура, СтавкаНДС, Отчет);
	
	Возврат СтрСоединить(Отчет, Символы.ПС);
	
КонецФункции

Функция ОрганизацияПоУмолчанию()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Организации.ПустаяСсылка();
	
КонецФункции

Функция ОбеспечитьСклад(Отчет)
	
	Имя = "КД Основной склад";
	Ссылка = Справочники.Склады.НайтиПоНаименованию(Имя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Отчет.Добавить("Склад: уже был");
		Возврат Ссылка;
	КонецЕсли;
	
	Объект = Справочники.Склады.СоздатьЭлемент();
	Объект.Наименование = Имя;
	Объект.ТипСклада = Перечисления.ТипыСкладов.ОптовыйСклад;
	Объект.ВыборГруппы = Перечисления.ВыборГруппыСкладов.Запретить;
	// Пустая база не прошла начальное заполнение: перед записью склада типовой код
	// читает функциональные опции и падает на преобразовании к Булево. Режим загрузки это обходит.
	ЗаписатьОбъект(Объект, "Склад", Истина);
	Отчет.Добавить("Склад: создан");
	Возврат Объект.Ссылка;
	
КонецФункции

Функция ОбеспечитьВидЦен(Валюта, Отчет)
	
	Имя = "КД Тестовый вид цен";
	Ссылка = Справочники.ВидыЦен.НайтиПоНаименованию(Имя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Отчет.Добавить("Вид цен: уже был");
		Возврат Ссылка;
	КонецЕсли;
	
	Объект = Справочники.ВидыЦен.СоздатьЭлемент();
	Объект.Наименование = Имя;
	Объект.Идентификатор = "кдТестовая";
	Объект.ВалютаЦены = Валюта;
	Объект.СпособЗаданияЦены = Перечисления.СпособыЗаданияЦен.Вручную;
	Объект.Статус = Перечисления.СтатусыДействияВидовЦен.Действует;
	Объект.ИспользоватьПриПродаже = Истина;
	Объект.ИспользоватьПриОптовойПродаже = Истина;
	Объект.ЦенаВключаетНДС = Истина;
	ЗаписатьОбъект(Объект, "Вид цен", Истина);
	Отчет.Добавить("Вид цен: создан");
	Возврат Объект.Ссылка;
	
КонецФункции

Функция ОбеспечитьВидНоменклатуры(Отчет)
	
