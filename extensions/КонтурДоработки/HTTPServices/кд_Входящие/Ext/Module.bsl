// Приём письма. Категория считается в кд_ВходящиеОбращения.
// Повтор того же текста не создаёт второй элемент.

Функция incomingPOST(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
	
	Попытка
		Канал = Запрос.ПараметрыURL.Получить("channel");
		Тело = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ТекстПисьма = ТекстИзТела(Тело);
		Если Не ЗначениеЗаполнено(ТекстПисьма) Тогда
			Ответ.КодСостояния = 400;
			Ответ.УстановитьТелоИзСтроки("Нет поля text", КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		Категория = кд_ВходящиеОбращения.КатегорияПоТексту(ТекстПисьма);
		Наименование = Лев(СокрЛП(ТекстПисьма), 150);
		Существующий = Справочники.кд_ВходящееОбращение.НайтиПоНаименованию(Наименование, Истина);
		Если ЗначениеЗаполнено(Существующий) Тогда
			Ответ.УстановитьТелоИзСтроки("уже было, категория " + Существующий.Категория, КодировкаТекста.UTF8);
			Возврат Ответ;
		КонецЕсли;
		
		Объект = Справочники.кд_ВходящееОбращение.СоздатьЭлемент();
		Объект.Наименование = Наименование;
		Объект.Канал = Канал;
		Объект.Текст = ТекстПисьма;
		Объект.Категория = Категория;
		Объект.Записать();
		Ответ.УстановитьТелоИзСтроки("создано, категория " + Категория, КодировкаТекста.UTF8);
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), КодировкаТекста.UTF8);
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

Функция ТекстИзТела(Тело)
	
	Если Не ЗначениеЗаполнено(Тело) Тогда
		Возврат "";
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Тело);
	Данные = ПрочитатьJSON(Чтение);
	Если ТипЗнч(Данные) = Тип("Соответствие") И Данные.Получить("text") <> Неопределено Тогда
		Возврат Строка(Данные.Получить("text"));
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("text") Тогда
		Возврат Строка(Данные.text);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции
